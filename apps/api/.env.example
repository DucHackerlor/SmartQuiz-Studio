# Khong chia se khoa API. Dung 1_CAI_DAT_GROQ.bat de nhap khoa mot lan tren may.
# Groq Free - no card (AI_PROVIDER=groq), or switch back to gemini
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-32-chars-minimum
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=high
# AI_MODE=real: key bat buoc, AI_MODE=demo: khong goi API AI
AI_MODE=real
WEB_ORIGIN=http://localhost:5173
# Gioi han cong dong (moi upload anh/PDF scan va moi lan tao quiz AI = 1 luot)
AI_USER_DAILY_LIMIT=4
AI_GLOBAL_DAILY_LIMIT=30
# Tuy chon: duong dan SQLite, mac dinh apps/api/data/smartquiz.sqlite
# DB_PATH=
